DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/library_db
LOG_LEVEL=INFO
ENVIRONMENT=local
JWT_SECRET_KEY=change-me-in-production-min-32-bytes-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost
